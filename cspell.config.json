{
    "version": "0.2",
    "language": "en-US",
    "words": [
        "nextjs",
        "drizzle",
        "biome",
        "tailwindcss",
        "radix",
        "hookform",
        "zustand",
        "tanstack",
        "uploadthing",
        "resend",
        "sonner",
        "lucide",
        "clsx",
        "cva",
        "betterauth",
        "neon",
        "vercel",
        "husky",
        "commitlint",
        "eslintrc",
        "editorconfig",
        "toploader",
        "pnpm",
        "postgres",
        "postgresql",
        "oauth",
        "signin",
        "signup",
        "snapdish",
        "clientkind",
        "useragent",
        "ipaddress",
        "accesstoken",
        "refreshtoken",
        "idtoken",
        "autosignin",
        "gmail",
        "middleware",
        "shadcn",
        "pooler",
        "gstatic",
        "ecommerce",
        "organised",
    ],
    "ignorePaths": [
        "node_modules/**",
        ".next/**",
        "build/**",
        "coverage/**",
        "src/db/migrations/**",
        "*.lock",
        "*.log",
        "*.min.js",
        "*.min.css",
        ".git/**",
        "pnpm-lock.yaml",
        "package-lock.json",
        "*.md"
    ],
    "ignoreWords": [
        "pkgs",
        "deps",
        "impl",
        "struct",
        "attrs",
        "props",
        "config"
    ],
    "allowCompoundWords": true,
    "dictionaries": [
        "typescript",
        "node",
        "html",
        "css",
        "bash"
    ],
    "languageSettings": [
        {
            "languageId": "typescript,javascript",
            "ignoreRegExpList": [
                "/\\w*[A-Z]\\w*/g",
                "/\\b\\w+[0-9]+\\w*\\b/g"
            ]
        }
    ]
}