        "nextjs-toploader": "^3.9.17",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.89.0",
        "resend": "^6.32.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "three": "^0.186.1",
        "tw-animate-css": "^1.4.0",
        "ua-parser-js": "^2.0.10",
        "uploadthing": "^7.7.4",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
