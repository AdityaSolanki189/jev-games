{
    "name": "nextjs-drizzle-betterAuth-biome-template",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome lint . --fix",
        "check": "biome check .",
        "format": "biome format . --write",
        "spell": "cspell \"src/**/*.{js,jsx,ts,tsx,md,mdx}\" \"*.{js,jsx,ts,tsx,md,mdx}\"",
        "spell:fix": "cspell \"src/**/*.{js,jsx,ts,tsx,md,mdx}\" \"*.{js,jsx,ts,tsx,md,mdx}\" --show-suggestions",
        "prepare": "husky",
        "precommit": "lint-staged",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
        "db:push": "drizzle-kit push --config=drizzle.config.ts",
        "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "sprites:atlas": "node scripts/generate-atlas.mjs",
        "sprites:cactus": "node scripts/recolor-cactus.mjs",
        "sprites:birds": "node scripts/flip-birds.mjs",
        "sprites:scenery": "node scripts/extract-scenery.mjs",
        "sim:rules": "tsx scripts/sim-rules.ts",
        "bench:laya": "tsx scripts/bench-laya.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@neondatabase/serverless": "^1.0.2",
        "@radix-ui/react-accordion": "^1.2.21",
